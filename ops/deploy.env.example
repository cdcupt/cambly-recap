# ops/deploy.env.example — template for the server-side deploy.env (TECH §6 "Secrets").
#
# The REAL file lives on the server (e.g. /root/.cambly-recap/deploy.env), is chmod
# 600, and is NEVER committed (the repo carries no secrets — PRD S6). Copy this file,
# fill in real values on the box, then `chmod 600`. Consumed by both compose services
# via `env_file` (the generator reads the API/mail/config keys; the caddy service
# reads only BASIC_AUTH_HASH). Every NAME below is an env var run.js — or the app
# Caddyfile — actually reads; do not add keys the code does not honour.

# ── OpenAI (summarizer) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME            # your OpenAI API key
OPENAI_MODEL=gpt-5.5                    # summarizer model — swap without a code change

# ── Resend (mailer — one email per run) ───────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME           # your Resend API key (send-only is fine)
MAIL_FROM=Cambly Recap <recap@your-domain.example.com>  # a verified Resend sender

# ── Site / links ──────────────────────────────────────────────────────────────────
MAIL_TO=you@example.com                # recap + alert recipient
SITE_URL=https://your-domain.example.com # email deep links + healthz URL (no trailing slash)

# ── Cambly identity (not secret, but env-kept; UA travels inside cambly-state.json) ─
CAMBLY_UID=your-cambly-user-id         # your Cambly user id

# ── Backfill floor ────────────────────────────────────────────────────────────────
FIRST_WEEK=2026-05-04                  # Monday (Asia/Shanghai) of your earliest week; bounds --backfill + self-heal

# ── Serving auth (consumed by the app Caddyfile as {$BASIC_AUTH_HASH}) ──────────────
BASIC_AUTH_HASH=$2a$14$REPLACE_ME      # bcrypt from: docker run --rm caddy:2-alpine caddy hash-password

# ── Optional env seams (defaults are production-correct; uncomment only to override) ─
# CAMBLY_BASE_URL=https://www.cambly.com
# OPENAI_BASE_URL=https://api.openai.com
# RESEND_BASE_URL=https://api.resend.com
